generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMERADORES ---

enum Rol {
  SUPERADMIN
  LABORATORIO
  BIOANALISTA
  ASISTENTE
}


// --- NUEVO MODELO LABORATORIO ---

model Laboratorio {
  id            String   @id @default(cuid())
  nombre        String
  logoBase64    String?  @db.Text
  telefono      String?
  correo        String?
  direccion     String?
  rif           String?
  ciudad        String?
  estado        String?
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now())

  // Configuracion fusionada
  volumenPruebasMensualEstimado Int @default(1000)
  claveMaestra                  String @default("123456")

  // Relaciones Directas (Parents)
  usuarios            Usuario[]
  pacientes           Paciente[]
  ordenes             Orden[]
  detallesOrden       DetalleOrden[]
  resultados          ResultadoPrueba[]
  valoresResultados   ValorResultado[]
  pagos               Pago[]
  gastos              Gasto[]
  cierres             CierreCaja[]
  categorias          CategoriaPrueba[]
  subcategorias       SubcategoriaPrueba[]
  pruebas             Prueba[]
  metodosPago         MetodoPago[]
  serviciosExtra      ServicioExtra[]
  serviciosEnOrden    ServicioEnOrden[]
  costosFijos         CostoFijo[]
  insumos             Insumo[]
  paquetesInsumo      PaqueteInsumo[]
  paquetesInsumoItem  PaqueteInsumoItem[]
  pruebasInsumo       PruebaInsumo[]
  subcategoriasInsumo SubcategoriaInsumo[]
  notasSubcategoria   NotaSubcategoriaOrden[]
}

// --- TABLAS DE REFERENCIA GLOBALES ---
// Estas no tienen laboratorioId porque son estáticas/globales del sistema.

model EstadoOrden {
  id      Int     @id @default(autoincrement())
  nombre  String  @unique
  ordenes Orden[]
}

model TipoDescuento {
  id            Int            @id @default(autoincrement())
  nombre        String         @unique
  ordenes       Orden[]
  detallesOrden DetalleOrden[]
}

// --- CATÁLOGOS POR LABORATORIO ---

model MetodoPago {
  id            Int         @id @default(autoincrement())
  nombre        String
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  pagos  Pago[]
  gastos Gasto[]

  @@unique([laboratorioId, nombre])
  @@unique([id, laboratorioId])
}

model CategoriaPrueba {
  id            Int         @id @default(autoincrement())
  nombre        String
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  subcategorias SubcategoriaPrueba[]

  @@unique([laboratorioId, nombre])
  @@unique([id, laboratorioId])
}

model SubcategoriaPrueba {
  id        String  @id @default(cuid())
  nombre    String
  activa    Boolean @default(true)
  esPaquete Boolean @default(false)
  precioUSD Float?

  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  categoriaId Int
  categoria   CategoriaPrueba @relation(fields: [categoriaId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  pruebas          Prueba[]
  insumosAsociados SubcategoriaInsumo[]

  @@unique([laboratorioId, nombre])
  @@unique([id, laboratorioId])
}

model Prueba {
  id                   String  @id @default(cuid())
  codigo               String
  nombre               String
  precioUSD            Float?
  margenGanancia       Float?
  unidades             String?
  valoresReferencia    String?
  opcionesPredefinidas String?
  activa               Boolean @default(true)
  ordenVisual          Int     @default(0)
  categoriaVisual      String?
  subcategoriaVisual   String?

  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  subcategoriaId String
  subcategoria   SubcategoriaPrueba @relation(fields: [subcategoriaId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  detallesOrden     DetalleOrden[]
  valoresResultados ValorResultado[]
  insumosAsociados  PruebaInsumo[]

  @@unique([laboratorioId, codigo])
  @@unique([id, laboratorioId])
}

// --- MODELOS PRINCIPALES ---

model Usuario {
  id       String  @id @default(cuid())
  nombre   String
  correo   String  @unique
  clave    String
  pinFirma String?
  firmaUrl String?
  mpps     String?
  col      String?
  activo   Boolean @default(true)
  rol      Rol     @default(ASISTENTE)

  laboratorioId String?
  laboratorio   Laboratorio? @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  ordenesCreadas      Orden[]
  gastosRegistrados   Gasto[]
  resultadosValidados ResultadoPrueba[]
  fechaCreacion       DateTime          @default(now())
  cierresRealizados   CierreCaja[]
}

model Paciente {
  id              String   @id @default(cuid())
  cedula          String?
  nombreCompleto  String
  fechaNacimiento DateTime
  esBebe          Boolean  @default(false)
  sexo            String
  telefono        String?
  correo          String?
  direccion       String?
  observaciones   String?  @db.Text

  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  ordenes       Orden[]
  fechaRegistro DateTime @default(now())

  @@unique([laboratorioId, cedula])
  @@unique([id, laboratorioId])
  @@index([laboratorioId, nombreCompleto])
  @@index([laboratorioId, fechaRegistro])
}

model Orden {
  id            Int         @id @default(autoincrement())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  usuarioId String
  creadoPor Usuario @relation(fields: [usuarioId], references: [id])

  estadoId Int
  estado   EstadoOrden @relation(fields: [estadoId], references: [id])

  subtotalUSD           Float
  descuentoGeneral      Float          @default(0)
  tipoDescuentoId       Int?
  tipoDescuento         TipoDescuento? @relation(fields: [tipoDescuentoId], references: [id])
  totalUSD              Float
  totalBS               Float
  tasaBCV               Float
  resultadosCompletados Boolean        @default(false)
  fechaCreacion         DateTime       @default(now())

  pagos             Pago[]
  detalles          DetalleOrden[]
  serviciosExtra    ServicioEnOrden[]
  notasSubcategoria NotaSubcategoriaOrden[]

  @@unique([id, laboratorioId])
  @@index([laboratorioId, fechaCreacion])
  @@index([laboratorioId, estadoId])
  @@index([laboratorioId, pacienteId])
  @@index([laboratorioId, resultadosCompletados])
}

model DetalleOrden {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  ordenId Int
  orden   Orden @relation(fields: [ordenId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  pruebaId String
  prueba   Prueba @relation(fields: [pruebaId, laboratorioId], references: [id, laboratorioId])

  cantidad           Int            @default(1)
  precioCongeladoUSD Float
  descuento          Float          @default(0)
  tipoDescuentoId    Int?
  tipoDescuento      TipoDescuento? @relation(fields: [tipoDescuentoId], references: [id])

  resultado ResultadoPrueba?

  @@unique([id, laboratorioId])
}

model ResultadoPrueba {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  detalleOrdenId String
  detalleOrden   DetalleOrden @relation(fields: [detalleOrdenId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  usuarioId    String
  procesadoPor Usuario @relation(fields: [usuarioId], references: [id])

  observaciones     String?          @db.Text
  firmado           Boolean          @default(false)
  fechaProcesado    DateTime         @default(now())
  valores           ValorResultado[]
  valoresReferencia String?          @db.Text

  @@unique([id, laboratorioId])
  @@unique([detalleOrdenId, laboratorioId])
}

model ValorResultado {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  resultadoId String
  resultado   ResultadoPrueba @relation(fields: [resultadoId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  pruebaId String
  prueba   Prueba @relation(fields: [pruebaId, laboratorioId], references: [id, laboratorioId])

  valorIngresado String
}

model Pago {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  ordenId Int
  orden   Orden @relation(fields: [ordenId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  metodoId Int
  metodo   MetodoPago @relation(fields: [metodoId, laboratorioId], references: [id, laboratorioId])

  montoUSD   Float
  montoBS    Float
  referencia String?
  fechaPago  DateTime @default(now())
}

model Gasto {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  usuarioId     String
  registradoPor Usuario @relation(fields: [usuarioId], references: [id])

  concepto String
  metodoId Int
  metodo   MetodoPago @relation(fields: [metodoId, laboratorioId], references: [id, laboratorioId])

  montoUSD   Float
  montoBS    Float
  referencia String?
  fechaGasto DateTime @default(now())
}

model CierreCaja {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  usuarioId    String
  realizadoPor Usuario @relation(fields: [usuarioId], references: [id])

  fechaApertura DateTime
  fechaCierre   DateTime @default(now())

  totalCalculadoUSD Float
  totalCalculadoBS  Float
  totalDeclaradoUSD Float?
  totalDeclaradoBS  Float?

  descuadreUSD Float?
  descuadreBS  Float?

  tasaBCV       Float
  observaciones String? @db.Text

  desgloseMetodos String? @db.Text
}

// --- SERVICIOS LOGÍSTICOS ---

model ServicioExtra {
  id        Int     @id @default(autoincrement())
  nombre    String
  precioUSD Float
  activo    Boolean @default(true)

  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  ordenes ServicioEnOrden[]

  @@unique([laboratorioId, nombre])
  @@unique([id, laboratorioId])
}

model ServicioEnOrden {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  ordenId Int
  orden   Orden @relation(fields: [ordenId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  servicioId Int
  servicio   ServicioExtra @relation(fields: [servicioId, laboratorioId], references: [id, laboratorioId])

  cantidad           Int   @default(1)
  precioCongeladoUSD Float
}

// --- ESTRUCTURA DE COSTOS ---

model CostoFijo {
  id              Int     @id @default(autoincrement())
  nombre          String
  montoMensualUSD Float
  activo          Boolean @default(true)

  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  @@unique([laboratorioId, nombre])
}

model Insumo {
  id               Int     @id @default(autoincrement())
  nombre           String
  unidadMedida     String
  costoUnitarioUSD Float
  cantidadComprada Float?
  costoTotalUSD    Float?
  activo           Boolean @default(true)

  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  pruebasAsociadas       PruebaInsumo[]
  paquetesAsociados      PaqueteInsumoItem[]
  subcategoriasAsociadas SubcategoriaInsumo[]

  @@unique([laboratorioId, nombre])
  @@unique([id, laboratorioId])
}

model PruebaInsumo {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  pruebaId String
  prueba   Prueba @relation(fields: [pruebaId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  insumoId Int
  insumo   Insumo @relation(fields: [insumoId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  cantidadUsada Float

  @@unique([pruebaId, insumoId])
}

model PaqueteInsumo {
  id     Int     @id @default(autoincrement())
  nombre String
  activo Boolean @default(true)

  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  items PaqueteInsumoItem[]

  @@unique([laboratorioId, nombre])
  @@unique([id, laboratorioId])
}

model PaqueteInsumoItem {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  paqueteId Int
  paquete   PaqueteInsumo @relation(fields: [paqueteId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  insumoId Int
  insumo   Insumo @relation(fields: [insumoId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  cantidadUsada Float

  @@unique([paqueteId, insumoId])
}

model SubcategoriaInsumo {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  subcategoriaId String
  subcategoria   SubcategoriaPrueba @relation(fields: [subcategoriaId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  insumoId Int
  insumo   Insumo @relation(fields: [insumoId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  cantidadUsada Float

  @@unique([subcategoriaId, insumoId])
}

model NotaSubcategoriaOrden {
  id            String      @id @default(cuid())
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)

  ordenId Int
  orden   Orden @relation(fields: [ordenId, laboratorioId], references: [id, laboratorioId], onDelete: Cascade)

  subcategoria String
  nota         String @db.Text

  @@unique([ordenId, subcategoria])
}
